{
  "manifest_version": 3,
  "name": "우리애 한눈에",
  "short_name": "우리애 한눈에",
  "version": "0.1.0",
  "description": "준비물·일정은 한눈에, 우리 아이 사진만 골라서 한 번에. 키즈노트 웹과 함께 쓰는 비공식 도구. 모든 처리는 내 컴퓨터 안에서만.",
  "homepage_url": "https://kids.emilysoft.com",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "우리애 한눈에"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://kapi.kidsnote.com/*",
    "https://www.kidsnote.com/*",
    "https://up-kids-kage.kakao.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
